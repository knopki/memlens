{
	"name": "@memlens/root",
	"version": "0.0.2",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.17.0",
	"engines": {
		"node": "^22.19.0 || >=24.0.0"
	},
	"scripts": {
		"build": "pnpm -r run build",
		"typecheck": "pnpm -r run typecheck",
		"test": "pnpm -r run test",
		"lint": "biome check . && node scripts/check-regions.mjs",
		"format": "biome check --write .",
		"arch": "likec4 start docs/arch",
		"arch:export": "likec4 export markdown --force docs/arch",
		"lint:docs": "sh scripts/ste-lint.sh && node scripts/check-tables.mjs && likec4 validate docs/arch",
		"verify": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run lint:docs && pnpm change check"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"likec4": "^1.61.0"
	}
}
