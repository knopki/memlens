{
	"name": "memlens",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.17.0",
	"engines": {
		"node": "^22.19.0 || >=24.0.0"
	},
	"scripts": {
		"build": "pnpm -r run build",
		"typecheck": "pnpm -r run typecheck",
		"test": "pnpm -r run test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"lint:docs": "sh scripts/ste-lint.sh",
		"verify": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run lint:docs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4"
	}
}
