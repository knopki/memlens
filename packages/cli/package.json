{
	"name": "@memlens/cli",
	"version": "0.1.0",
	"description": "The CLI frontend of memlens.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/knopki/memlens.git",
		"directory": "packages/cli"
	},
	"type": "module",
	"bin": {
		"memlens": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && node build.mjs",
		"prepack": "cp ../../README.md README.md",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY vitest run"
	},
	"devDependencies": {
		"@memlens/core": "workspace:*",
		"@memlens/ui": "workspace:*",
		"@types/node": "^22.20.1",
		"esbuild": "^0.28.2",
		"smol-toml": "^1.9.1",
		"typescript": "^7.0.2",
		"vitest": "^3.2.7"
	},
	"engines": {
		"node": "^22.19.0 || >=24.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
