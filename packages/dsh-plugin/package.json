{
	"name": "@memlens/dsh-plugin",
	"version": "0.0.0",
	"description": "The DeepSeek Harness plugin of memlens.",
	"type": "module",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./preset": {
			"types": "./lib/preset.d.ts",
			"default": "./lib/preset.js"
		},
		"./locale/*.json": "./locale/*.json",
		"./icon": "./icon.svg"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"locale/*.json",
		"icon.svg",
		"README*.md"
	],
	"scripts": {
		"build": "rm -rf lib && node build.mjs && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node build.mjs && vitest run",
		"prepare": "node build.mjs && tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"@deepseek-ai/schemastery": "^3.18.2",
		"@memlens/core": "workspace:*"
	},
	"devDependencies": {
		"@deepseek-ai/cordis": "4.1.0",
		"@deepseek-ai/cordis-plugin-loader": "^1.1.0",
		"@deepseek-ai/dsh-agent": "0.2.2-rc.3",
		"@deepseek-ai/dsh-llm": "0.2.2-rc.3",
		"@deepseek-ai/dsh-scope": "0.2.2-rc.3",
		"@deepseek-ai/dsh-workspace": "0.2.2-rc.3",
		"@types/node": "^22.20.1",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2",
		"vitest": "^3.2.7",
		"yaml": "^2.9.1"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.2",
		"@deepseek-ai/dsh-agent": ">=0.2.1-0 <0.3.0",
		"@deepseek-ai/dsh-llm": ">=0.2.1-0 <0.3.0",
		"@deepseek-ai/dsh-scope": ">=0.2.1-0 <0.3.0",
		"@deepseek-ai/dsh-workspace": ">=0.2.1-0 <0.3.0"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/dsh-workspace": {
			"optional": true
		}
	},
	"dsh": {
		"manifestVersion": 1,
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	},
	"engines": {
		"node": "^22.19.0 || >=24.0.0",
		"dsh": ">=0.2.1-0"
	}
}
