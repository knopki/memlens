{
	"name": "@memlens/ui",
	"version": "0.2.0",
	"description": "The browser console of memlens.",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./standalone": {
			"types": "./dist/standalone/main.d.ts",
			"default": "./dist/standalone/main.js"
		},
		"./standalone/index.html": "./dist/standalone/index.html",
		"./standalone/style.css": "./dist/standalone/style.css",
		"./styles": {
			"types": "./dist/styles.d.ts",
			"default": "./dist/styles.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node build.mjs",
		"prepare": "pnpm run build",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
	},
	"dependencies": {
		"@memlens/core": "workspace:*"
	},
	"devDependencies": {
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"happy-dom": "^18.0.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^7.0.2",
		"vitest": "^3.2.7"
	},
	"peerDependencies": {
		"react": ">=18.2.0",
		"react-dom": ">=18.2.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"engines": {
		"node": "^22.19.0 || >=24.0.0"
	}
}
